# Database
DATABASE_URL="postgresql://uptool:uptool@localhost:5432/uptool"

# Auth.js v5
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
# Required: tells Auth.js the canonical base URL; determines cookie name prefix (http vs https)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth — https://console.cloud.google.com/
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft OAuth — https://portal.azure.com/
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="common"

# Resend — https://resend.com/
# Leave empty in dev to console-log magic links instead of sending email
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Redis
REDIS_URL="redis://localhost:6379"

# Sentry — https://sentry.io/
# Leave empty or set SENTRY_ENABLED=false to disable
SENTRY_DSN=""
SENTRY_ENABLED="false"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# File storage — Minio locally, any S3-compatible in prod
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="uptool-attachments"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="uptool"
S3_SECRET_ACCESS_KEY="uptool123"
S3_PUBLIC_URL=""

# Token encryption for OAuth tokens stored in DB
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Microsoft email OAuth (add Mail.Read, Mail.Send to existing Azure app + this redirect URI)
MICROSOFT_GRAPH_REDIRECT_URI="http://localhost:3000/api/email-accounts/callback/microsoft"

# Google email OAuth (add Gmail scopes to existing Google OAuth app + this redirect URI)
GOOGLE_GMAIL_REDIRECT_URI="http://localhost:3000/api/email-accounts/callback/gmail"

# Postmark inbound webhook — for forwarding address feature
# Set the same secret in Postmark's inbound webhook settings (HTTP header: X-Postmark-Signature)
POSTMARK_INBOUND_WEBHOOK_SECRET=""
# The domain used for sending transactional email via Postmark (e.g. toolup.de)
POSTMARK_FROM_DOMAIN=""
