{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "incremental": true,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@uptool/db": ["../../packages/db/src/index.ts"],
      "@uptool/db/*": ["../../packages/db/src/*.ts"],
      "@uptool/shared": ["../../packages/shared/src/index.ts"],
      "@uptool/shared/*": ["../../packages/shared/src/*.ts"],
      "@uptool/services": ["../../packages/services/src/index.ts"],
      "@uptool/services/*": ["../../packages/services/src/*.ts"],
      "@uptool/ui": ["../../packages/ui/src/index.ts"],
      "@uptool/ui/*": ["../../packages/ui/src/*.tsx", "../../packages/ui/src/*.ts"]
    },
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
